{
  "name": "pi-workbuddy-hub",
  "version": "0.1.1",
  "description": "WorkBuddy（CodeBuddy）一体化中枢：内置 provider（国内/国际双区域）+ 多账号签到、切换、限流自动换号",
  "type": "module",
  "license": "MIT",
  "author": "lucaslz",
  "homepage": "https://github.com/lucaslz2020/pi-workbuddy-hub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucaslz2020/pi-workbuddy-hub.git"
  },
  "bugs": {
    "url": "https://github.com/lucaslz2020/pi-workbuddy-hub/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "pi-workbuddy-hub",
    "pi-package",
    "pi",
    "workbuddy",
    "codebuddy",
    "provider",
    "checkin",
    "multi-account",
    "failover"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "src",
    "bin"
  ],
  "bin": {
    "wb-checkin": "bin/checkin.mjs"
  },
  "scripts": {
    "checkin": "node bin/checkin.mjs",
    "tidy": "node bin/tidy.mjs",
    "typecheck": "npx --yes -p typescript@5 tsc -p tsconfig.check.json --noEmit",
    "checkbins": "node --check bin/checkin.mjs && node --check bin/extract-at-rest-key.mjs",
    "test": "npm run typecheck && npm run checkbins",
    "prepublishOnly": "npm test"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "^26.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
